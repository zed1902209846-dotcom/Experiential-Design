  m_Script: {fileID: 11500000, guid: aac5222cf7d635e46be0e531654d9534, type: 3}
  m_Name: sun
  m_EditorClassIdentifier: Assembly-CSharp::SolarSystemAR.CelestialBodyData
  id: sun
  displayName: "\u592A\u9633"
  englishName: The Sun
  shortDescription: "\u592A\u9633\u662F\u592A\u9633\u7CFB\u7684\u4E2D\u5FC3\u6052\u661F\uFF0C\u5360\u7CFB\u7EDF\u603B\u8D28\u91CF\u7684
    99.86%\uFF0C\u5176\u6838\u805A\u53D8\u4E3A\u6574\u4E2A\u7CFB\u7EDF\u63D0\u4F9B\u5149\u4E0E\u70ED\u3002"
  shortDescriptionEn: The Sun is the central star of the Solar System, holding 99.86%
    of its total mass and powering everything with nuclear fusion.
  fullDescription: "\u592A\u9633\u662F\u4E00\u9897 G \u578B\u4E3B\u5E8F\u661F\uFF08\u9EC4\u77EE\u661F\uFF09\uFF0C\u6838\u5FC3\u6E29\u5EA6\u7EA6
    1500 \u4E07\u6444\u6C0F\u5EA6\uFF0C\u6BCF\u79D2\u5C06\u7EA6 6 \u4EBF\u5428\u6C22\u805A\u53D8\u4E3A\u6C26\u3002\u5B83\u8BDE\u751F\u4E8E\u7EA6
    46 \u4EBF\u5E74\u524D\u7684\u5206\u5B50\u4E91\u574D\u7F29\uFF0C\u76EE\u524D\u6B63\u5904\u4E8E\u4E3B\u5E8F\u661F\u9636\u6BB5\u7684\u58EE\u5E74\uFF0C\u9884\u8BA1\u8FD8\u80FD\u7A33\u5B9A\u71C3\u70E7\u7EA6
    50 \u4EBF\u5E74\u3002"
  fullDescriptionEn: "The Sun is a G-type main-sequence star with a core temperature
    of about 15 million \xB0C, fusing roughly 600 million tons of hydrogen into helium
    every second. Born about 4.6 billion years ago, it will remain stable for roughly
    another 5 billion years."
  diameter: 1,392,700 km
  rotationPeriod: "\u7EA6 25.4 \u5929\uFF08\u8D64\u9053\uFF09"
  orbitalPeriod: "\u7ED5\u94F6\u6CB3\u7CFB\u4E2D\u5FC3\u7EA6 2.3 \u4EBF\u5E74"
  age: "\u7EA6 46 \u4EBF\u5E74"
  characteristics: "G \u578B\u4E3B\u5E8F\u661F\uFF1B\u8868\u9762\u7EA6 5500\xB0C\uFF1B\u5149\u7403\u5C42/\u8272\u7403\u5C42/\u65E5\u5195\u7ED3\u6784\uFF1B\u5468\u671F\u6027\u9ED1\u5B50\u4E0E\u8000\u6591\u6D3B\u52A8"
  icon: {fileID: 0}
  narration: {fileID: 0}
